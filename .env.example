# ==============================================
# Raspberry Light Jockey - Environment Variables
# ==============================================
#
# ISTRUZIONI:
# 1. Copia questo file in .env
# 2. Sostituisci i valori placeholder con le tue API keys reali
# 3. NON committare mai il file .env nel repository
#
# ==============================================

# Google Gemini API Key
# Ottienila da: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key
# Ottienila da: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# ==============================================
# OPTIONAL: Database & Logging
# ==============================================

# Percorso del database (default: ./data/light_jockey.db)
# DB_PATH=./data/light_jockey.db

# Livello di logging (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
